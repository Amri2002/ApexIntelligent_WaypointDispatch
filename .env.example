# Copy to .env (docker compose) or web/.env.local (npm run dev).
# Postgres connection string. With docker compose this is set for you.
DATABASE_URL=postgres://waypoint:waypoint@localhost:5432/waypoint
# Secret used to sign session cookies. Use 32+ random characters in production.
AUTH_SECRET=change-me-in-production-32-chars-min
# Folder that holds the seed CSVs (outlets.csv, vehicles.csv, ...). Defaults to ../data.
DATA_DIR=../data
# Set to 1 to wipe and re-seed the demo day on start (handy before a judging session).
SEED_FORCE=0
# Demo mode (default true) shows the "(demo)" outlet / vehicle pickers so one seeded account can show every case.
# Set to false for real use: each store manager, driver and loader is then held to their own outlet, vehicle and depot.
DEMO_MODE=true
